    ],
    "apps": [
      "claude",
      "codex",
      "hermes"
    ],
    "tools": []
  },
  "default": "off",
  "gate": null,
  "kit": "kits/simon",
  "entry": {
    "plan": "eutonos.component_simon:plan",
    "apply": "eutonos.component_simon:apply",
    "verify": "eutonos.component_simon:verify",
    "remove": "eutonos.component_simon:remove"
  },
  "permissions": [
    "simon-codex-rule"
  ],
  "consent_lines": [
    "simon-codex-rule"
  ],
  "licence": {
    "required": false,
    "check": null
